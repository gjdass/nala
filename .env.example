# Copy to .env and adjust. Never commit .env.

# Host port the app is served on (plain HTTP; put your own TLS reverse proxy in front).
NALA_HTTP_PORT=8080

# PostgreSQL database created on first start. Change the password before the first start.
POSTGRES_DB=nala
POSTGRES_USER=nala
POSTGRES_PASSWORD=change-me

# Password reset by email (optional). Leave SMTP_HOST empty to turn it off: the login screen then tells
# users to ask the admin for a reset link. When SMTP_HOST is set, SMTP_FROM and NALA_PUBLIC_URL are required.
# The address the app is reached at; emailed links start with it.
NALA_PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address, e.g. nala@example.com or "Nala <nala@example.com>".
SMTP_FROM=
# auto (from the port and the server's offer), starttls, ssl or none.
SMTP_SECURITY=auto
